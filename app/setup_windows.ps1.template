function Copy-BiosWithProgress([string]$SourceDir, [string]$DestinationDir) {
	$files = Get-ChildItem -Path $SourceDir -Recurse -File
	if ($files.Count -eq 0) {
		throw "No files found under source BIOS directory: $SourceDir"
	}

	$index = 0
	foreach ($file in $files) {
		$index++
		$relative = $file.FullName.Substring($SourceDir.Length).TrimStart('\', '/')
		$targetPath = Join-Path $DestinationDir $relative
		$targetFolder = Split-Path -Parent $targetPath
		
		# Ensure target folder exists
		if (-not (Test-Path $targetFolder)) {
			try {
				New-Item -Path $targetFolder -ItemType Directory -Force | Out-Null
			}
			catch {
				throw "Failed to create directory '$targetFolder': $($_.Exception.Message)"
			}
		}
		
		# Check if target exists as wrong type (e.g., file when we need directory)
		if ((Test-Path $targetPath) -and (Get-Item $targetPath).PSIsContainer) {
			Write-Warn "Removing incorrectly created directory: $targetPath"
			Remove-Item $targetPath -Force -Recurse
		}

		try {
			Copy-Item -Path $file.FullName -Destination $targetPath -Force -ErrorAction Stop
		}
		catch {
			throw "Failed to copy '$($file.FullName)' to '$targetPath': $($_.Exception.Message)"
		}

		$percent = [int](($index / $files.Count) * 100)
		Write-Progress -Activity "Copying RetroBat shared BIOS files" -Status "$index / $($files.Count): $relative" -PercentComplete $percent
	}
	Write-Progress -Activity "Copying RetroBat shared BIOS files" -Completed
}

function Update-RetroBatConfig([string]$RetroBatDir, [string]$BiosPath) {
	$configPath = Join-Path $RetroBatDir "emulationstation\emulatorLauncher.cfg"
	if (-not (Test-Path $configPath)) {
		throw "Cannot find emulatorLauncher.cfg at $configPath"
	}

	$backupPath = "$configPath.transfs"
	if (-not (Test-Path $backupPath)) {
		Copy-Item -Path $configPath -Destination $backupPath -Force
		Write-Ok "Backup created: $backupPath"
	}
	else {
		Write-Info "Backup already exists: $backupPath"
	}

	$lines = Get-Content -Path $configPath
	$updated = $false
	for ($i = 0; $i -lt $lines.Count; $i++) {
		if ($lines[$i] -match '^\s*bios=') {
			$lines[$i] = "bios=$BiosPath"
			$updated = $true
			break
		}
	}

	if (-not $updated) {
		$lines = @("bios=$BiosPath") + $lines
	}

	Set-Content -Path $configPath -Value $lines -Encoding UTF8
	Write-Ok "Updated bios= in $configPath"
}

function Update-RomPaths([string]$RetroBatDir, [string]$NativeDriveLetter) {
	$esSystemsPath = Join-Path $RetroBatDir "emulationstation\.emulationstation\es_systems.cfg"
	if (-not (Test-Path $esSystemsPath)) {
		Write-Warn "Cannot find es_systems.cfg at $esSystemsPath"
		return $false
	}

	$backupPath = "$esSystemsPath.transfs"
	if (-not (Test-Path $backupPath)) {
		Copy-Item -Path $esSystemsPath -Destination $backupPath -Force
		Write-Ok "Backup created: $backupPath"
	}
	else {
		Write-Info "Backup already exists: $backupPath"
	}

	[xml]$xmlContent = Get-Content -Path $esSystemsPath -Encoding UTF8
	$updated = $false

	# Find all systemList/system/path elements
	if ($xmlContent.systemList.system) {
		foreach ($system in $xmlContent.systemList.system) {
			if ($system.path) {
				$originalPath = $system.path
				# Replace relative paths (../) with native drive mapping
				# e.g., ../roms/megadrive becomes V:\roms\megadrive
				if ($originalPath -match '^\.\.[\\/]') {
					# Convert relative paths by removing ../ or ..\ prefix (3 chars)
					$relativePart = $originalPath.Substring(3)
					$newPath = "$NativeDriveLetter\$relativePart"
					$system.path = $newPath
					$updated = $true
					Write-Info "  Updated path: $originalPath -> $newPath"
				}
			}
		}
	}

	if ($updated) {
		$xmlContent.Save($esSystemsPath)
		Write-Ok "Updated es_systems.cfg ROM paths to use $NativeDriveLetter drive"
		return $true
	}
	else {
		Write-Info "No relative paths found to update in es_systems.cfg"
		return $false
	}
}

function Get-UniqueBackupPath([string]$Path) {
	$parent = Split-Path -Parent $Path
	$name = Split-Path -Leaf $Path
	$baseBackup = Join-Path $parent ("${name}_bak")

	if (-not (Test-Path $baseBackup)) {
		return $baseBackup
	}

	$counter = 1
	while ($true) {
		$candidate = Join-Path $parent ("${name}_bak${counter}")
		if (-not (Test-Path $candidate)) {
			return $candidate
		}
		$counter++
	}
}

function Test-IsReparseDirectory([string]$Path) {
	if (-not (Test-Path $Path)) {
		return $false
	}

	$item = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
	return $item.PSIsContainer -and (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0)
}

function Test-IsAdministrator {
	try {
		$currentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
		$principal = New-Object Security.Principal.WindowsPrincipal($currentIdentity)
		return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
	}
	catch {
		return $false
	}
}

function Copy-DirectoryContentsWithProgress([string]$SourceDir, [string]$DestinationDir, [string]$ActivityLabel) {
	$files = @(Get-ChildItem -LiteralPath $SourceDir -Recurse -File -ErrorAction Stop)
	$total = $files.Count

	if ($total -eq 0) {
		Write-Info "No files to copy for $ActivityLabel"
		return 0
	}

	Write-Info "Copying $total file(s) for $ActivityLabel..."
	$copied = 0
	foreach ($file in $files) {
		$relative = $file.FullName.Substring($SourceDir.Length).TrimStart('\\', '/')
		$destPath = Join-Path $DestinationDir $relative
		$destDir = Split-Path -Parent $destPath
		if (-not (Test-Path $destDir)) {
			New-Item -Path $destDir -ItemType Directory -Force | Out-Null
		}

		Copy-Item -LiteralPath $file.FullName -Destination $destPath -Force -ErrorAction Stop
		$copied++
		$percent = [int](($copied * 100) / $total)
		Write-Progress -Activity "Merging backup $ActivityLabel" -Status "$copied / ${total}: $relative" -PercentComplete $percent

		if (($copied % 250) -eq 0 -or $copied -eq $total) {
			Write-Info "Merge progress for ${ActivityLabel}: $copied / $total"
		}
	}

	Write-Progress -Activity "Merging backup $ActivityLabel" -Completed
	return $copied
}

function Invoke-ElevatedRetroBatLinkSetup(
	[string]$RomsPath,
	[string]$RomsTarget,
	[string]$BiosPath,
	[string]$BiosTarget,
	[string]$MergeRomsChoice = "N",
	[string]$MergeBiosChoice = "Y",
	[string]$RetroArchSystemPath = "",
	[string]$RetroArchSystemTarget = ""
) {
	$sharedDiagRoot = Join-Path $env:PUBLIC "Documents\TransFS\SetupTemp"
	if (-not (Test-Path $sharedDiagRoot)) {
		New-Item -ItemType Directory -Path $sharedDiagRoot -Force | Out-Null
	}

	$tempScript = Join-Path $sharedDiagRoot ("transfs-retrobat-link-" + [Guid]::NewGuid().ToString("N") + ".ps1")
	$tempLog = Join-Path $sharedDiagRoot ("transfs-retrobat-link-" + [Guid]::NewGuid().ToString("N") + ".log")
	$tempResult = Join-Path $sharedDiagRoot ("transfs-retrobat-link-" + [Guid]::NewGuid().ToString("N") + ".json")
	
	$scriptBody = @'
param(
	[string]$RomsPath,
	[string]$RomsTarget,
	[string]$BiosPath,
	[string]$BiosTarget,
	[string]$LogPath,
	[string]$ResultPath,
	[string]$MergeRomsChoice = "N",
	[string]$MergeBiosChoice = "Y",
	[string]$RetroArchSystemPath = "",
	[string]$RetroArchSystemTarget = ""
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

# Ensure log directory exists
if (-not [string]::IsNullOrWhiteSpace($LogPath)) {
	$logDir = Split-Path -Parent $LogPath
	if (-not (Test-Path $logDir)) {
		[void](New-Item -ItemType Directory -Path $logDir -Force)
	}
}

function Write-Log([string]$Message, [string]$Level = "INFO") {
	$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
	$line = "[$timestamp] [$Level] $Message"
	Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
	Write-Host $line
}

function Copy-DirectoryContentsWithProgress([string]$SourceDir, [string]$DestinationDir, [string]$ActivityLabel) {
	$files = @(Get-ChildItem -LiteralPath $SourceDir -Recurse -File -ErrorAction Stop)
	$total = $files.Count

	if ($total -eq 0) {
		Write-Log "No files to copy for $ActivityLabel" "INFO"
		return 0
	}

	Write-Log "Copying $total file(s) for $ActivityLabel..." "INFO"
	$copied = 0
	foreach ($file in $files) {
		$relative = $file.FullName.Substring($SourceDir.Length).TrimStart('\\', '/')
		$destPath = Join-Path $DestinationDir $relative
		$destDir = Split-Path -Parent $destPath
		if (-not (Test-Path $destDir)) {
			New-Item -Path $destDir -ItemType Directory -Force | Out-Null
		}

		Copy-Item -LiteralPath $file.FullName -Destination $destPath -Force -ErrorAction Stop
		$copied++
		$percent = [int](($copied * 100) / $total)
		Write-Progress -Activity "Merging backup $ActivityLabel" -Status "$copied / ${total}: $relative" -PercentComplete $percent

		if (($copied % 250) -eq 0 -or $copied -eq $total) {
			Write-Log "Merge progress for ${ActivityLabel}: $copied / $total" "INFO"
		}
	}

	Write-Progress -Activity "Merging backup $ActivityLabel" -Completed
	return $copied
}

try {
	Write-Log "Elevated script started: RomsPath=$RomsPath, BiosPath=$BiosPath"

	function Get-UniqueBackupPath([string]$Path) {
		$parent = Split-Path -Parent $Path
		$name = Split-Path -Leaf $Path
		$baseBackup = Join-Path $parent ("${name}_bak")

		if (-not (Test-Path $baseBackup)) {
			return $baseBackup
		}

		$counter = 1
		while ($true) {
			$candidate = Join-Path $parent ("${name}_bak${counter}")
			if (-not (Test-Path $candidate)) {
				return $candidate
			}
			$counter++
		}
	}

	function Test-IsReparseDirectory([string]$Path) {
		if (-not (Test-Path $Path)) {
			return $false
		}

		$item = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
		return $item.PSIsContainer -and (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0)
	}

	function Merge-BackupIntoLinkedFolder([string]$BackupPath, [string]$LinkedPath, [string]$Label, [string]$DefaultChoice = "Y") {
		if (-not (Test-Path $BackupPath -PathType Container)) {
			Write-Log "No backup folder found for $Label at $BackupPath" "INFO"
			return $false
		}

		if (-not (Test-Path $LinkedPath -PathType Container)) {
			Write-Log "Linked path missing for ${Label}: $LinkedPath" "WARN"
			return $false
		}

		# In elevated context, use default choice without prompting (non-interactive)
		Write-Log "Auto-merge (elevated mode): $Label from backup [$DefaultChoice]" "DEBUG"
		if ($DefaultChoice.ToUpperInvariant() -ne "Y") {
			Write-Log "Skipped merge from backup for $Label." "INFO"
			return $false
		}

		$sourceItems = Join-Path $BackupPath "*"
		try {
			$copied = Copy-DirectoryContentsWithProgress -SourceDir $BackupPath -DestinationDir $LinkedPath -ActivityLabel $Label
			Write-Log "Merged backup contents into linked $Label folder. Files copied: $copied" "OK"
			return $true
		}
		catch {
			Write-Log "Merge skipped for ${Label}: $($_.Exception.Message)" "WARN"
			return $false
		}
	}

	function Replace-DirectoryWithSymlink([string]$ExistingPath, [string]$TargetPath, [string]$Label, [string]$MergeDefault = "N") {
		Write-Log "Processing ${Label}: ExistingPath=$ExistingPath, TargetPath=$TargetPath" "DEBUG"
		
		if (-not (Test-Path $ExistingPath)) {
			Write-Log "$Label folder not found at $ExistingPath - skipping." "WARN"
			return $false
		}

		$item = Get-Item -LiteralPath $ExistingPath -Force -ErrorAction Stop
		if (-not $item.PSIsContainer) {
			Write-Log "$Label path is not a directory: $ExistingPath - skipping." "WARN"
			return $false
		}

		if (Test-IsReparseDirectory $ExistingPath) {
			Write-Log "$Label already uses a symlink/junction: $ExistingPath" "INFO"
			$existingBackup = "${ExistingPath}_bak"
			Merge-BackupIntoLinkedFolder -BackupPath $existingBackup -LinkedPath $ExistingPath -Label $Label -DefaultChoice "N" | Out-Null
			return $false
		}

		if (-not (Test-Path $TargetPath -PathType Container)) {
			Write-Log "$Label target path does not exist: $TargetPath" "WARN"
			return $false
		}

		$backupPath = Get-UniqueBackupPath $ExistingPath
		Write-Log "Renaming $ExistingPath to $backupPath" "DEBUG"
		Rename-Item -LiteralPath $ExistingPath -NewName (Split-Path -Leaf $backupPath) -ErrorAction Stop
		Write-Log "$Label folder backed up to $backupPath" "OK"

		Write-Log "Creating symlink: $ExistingPath -> $TargetPath" "DEBUG"
		New-Item -ItemType SymbolicLink -Path $ExistingPath -Target $TargetPath -ErrorAction Stop | Out-Null
		Write-Log "$Label folder now links to $TargetPath" "OK"
		Merge-BackupIntoLinkedFolder -BackupPath $backupPath -LinkedPath $ExistingPath -Label $Label -DefaultChoice $MergeDefault | Out-Null
		return $true
	}

	$changed = $false
	$changed = (Replace-DirectoryWithSymlink -ExistingPath $RomsPath -TargetPath $RomsTarget -Label "RetroBat ROMs" -MergeDefault $MergeRomsChoice) -or $changed
	$changed = (Replace-DirectoryWithSymlink -ExistingPath $BiosPath -TargetPath $BiosTarget -Label "RetroBat BIOS" -MergeDefault $MergeBiosChoice) -or $changed
	if (-not [string]::IsNullOrWhiteSpace($RetroArchSystemPath) -and -not [string]::IsNullOrWhiteSpace($RetroArchSystemTarget)) {
		$changed = (Replace-DirectoryWithSymlink -ExistingPath $RetroArchSystemPath -TargetPath $RetroArchSystemTarget -Label "RetroArch system" -MergeDefault "N") -or $changed
	}

	if ($changed) {
		Write-Log "Elevated symlink setup completed." "OK"
	}
	else {
		Write-Log "No link changes were required." "INFO"
	}

	@{ success = $true; changed = $changed; error = "" } | ConvertTo-Json -Compress | Set-Content -LiteralPath $ResultPath -Encoding UTF8
}
catch {
	$err = $_.Exception.Message
	Write-Log "ERROR: $($_.Exception.Message)" "ERROR"
	Write-Log "Stack: $($_.ScriptStackTrace)" "ERROR"
	@{ success = $false; changed = $false; error = $err } | ConvertTo-Json -Compress | Set-Content -LiteralPath $ResultPath -Encoding UTF8
	exit 1
}
'@

	Set-Content -LiteralPath $tempScript -Value $scriptBody -Encoding UTF8

	try {
$arguments = @(
"-NoProfile",
"-NonInteractive",
"-ExecutionPolicy", "Bypass",
"-File", $tempScript,
"-RomsPath", $RomsPath,
"-RomsTarget", $RomsTarget,
"-BiosPath", $BiosPath,
"-BiosTarget", $BiosTarget,
	"-LogPath", $tempLog,
	"-ResultPath", $tempResult,
	"-MergeRomsChoice", $MergeRomsChoice,
	"-MergeBiosChoice", $MergeBiosChoice,
	"-RetroArchSystemPath", $RetroArchSystemPath,
	"-RetroArchSystemTarget", $RetroArchSystemTarget
)

Write-Info "Requesting Administrator privileges for symlink creation (UAC prompt)..."
$proc = Start-Process -FilePath "powershell.exe" -ArgumentList $arguments -Verb RunAs -PassThru
$waitSeconds = 180
$elapsedSeconds = 0
while (-not $proc.HasExited -and $elapsedSeconds -lt $waitSeconds) {
Start-Sleep -Seconds 1
$elapsedSeconds++
}
if (-not $proc.HasExited) {
Write-ErrMsg "Elevated symlink setup timed out after $waitSeconds seconds."
Write-ErrMsg "An elevated window may still be waiting for input or blocked by permissions."
return @{ success = $false; changed = $false }
}

# Give elevated process time to flush the log
Start-Sleep -Milliseconds 500
		
		# Try to read and display the log output with retry logic
		$logContent = ""
		$retryCount = 0
		while ($retryCount -lt 3) {
			try {
				if (Test-Path $tempLog) {
					$logContent = Get-Content -LiteralPath $tempLog -Raw -ErrorAction Stop
					if (-not [string]::IsNullOrWhiteSpace($logContent)) {
						Write-Host $logContent
						break
					}
				}
			}
			catch {
				# Ignore transient read errors and retry below.
			}

			$retryCount++
			if ($retryCount -lt 3 -and [string]::IsNullOrWhiteSpace($logContent)) {
				Start-Sleep -Milliseconds 200
			}
		}
		
		if ([string]::IsNullOrWhiteSpace($logContent) -and (Test-Path $tempLog)) {
			# Log file exists but is empty
			Write-WarnMsg "Elevated script completed but produced no output log."
		}
		elseif ([string]::IsNullOrWhiteSpace($logContent)) {
			# Log file doesn't exist - elevated script may have crashed
			Write-WarnMsg "No log file found at $tempLog - elevated script may have failed to start."
			Write-Info "Temp script was at: $tempScript"
		}
		
		if ($null -eq $proc -or $proc.ExitCode -ne 0) {
			$code = if ($proc) { $proc.ExitCode } else { -1 }
			Write-ErrMsg "Elevated symlink setup failed (exit code $code). See output above for details."
			if (Test-Path $tempResult) {
				try {
					$result = Get-Content -LiteralPath $tempResult -Raw | ConvertFrom-Json
					if ($result.error) {
						Write-ErrMsg "Elevated detail: $($result.error)"
					}
				}
				catch {
					# Ignore result parse errors and keep original failure output.
				}
			}
			return @{ success = $false; changed = $false }
		}

		if (Test-Path $tempResult) {
			try {
				$result = Get-Content -LiteralPath $tempResult -Raw | ConvertFrom-Json
				if (-not $result.success) {
					Write-ErrMsg "Elevated link setup reported failure: $($result.error)"
					return @{ success = $false; changed = $false }
				}
				Write-Ok "Elevated symlink setup completed."
				return @{ success = $true; changed = [bool]$result.changed }
			}
			catch {
				Write-WarnMsg "Could not parse elevated result file; falling back to process exit status."
			}
		}

		Write-Ok "Elevated symlink setup completed."
		return @{ success = $true; changed = $false }
	}
	catch {
		Write-ErrMsg "Unable to complete elevated symlink setup: $($_.Exception.Message)"
		return @{ success = $false; changed = $false }
	}
	finally {
		# Keep temp files if there was an error, for debugging
		if ($null -ne $proc -and $proc.ExitCode -eq 0) {
			Remove-Item -LiteralPath $tempScript -Force -ErrorAction SilentlyContinue
			Remove-Item -LiteralPath $tempLog -Force -ErrorAction SilentlyContinue
			Remove-Item -LiteralPath $tempResult -Force -ErrorAction SilentlyContinue
		}
		else {
			Write-Info "Temp script kept at: $tempScript"
			Write-Info "Temp log kept at: $tempLog"
			Write-Info "Temp result kept at: $tempResult"
		}
	}
}

function Replace-DirectoryWithSymlink([string]$ExistingPath, [string]$TargetPath, [string]$Label, [string]$MergeDefault = "N") {
	if (-not (Test-Path $ExistingPath)) {
		Write-WarnMsg "$Label folder not found at $ExistingPath - skipping."
		return $false
	}

	$item = Get-Item -LiteralPath $ExistingPath -Force -ErrorAction Stop
	if (-not $item.PSIsContainer) {
		Write-WarnMsg "$Label path is not a directory: $ExistingPath - skipping."
		return $false
	}

	if (Test-IsReparseDirectory $ExistingPath) {
		Write-Info "$Label already uses a symlink/junction: $ExistingPath"
		$existingBackup = "${ExistingPath}_bak"
		$mergeChoice = Prompt-WithDefault "Merge files from '$existingBackup' into linked '$ExistingPath'? (Y/N)" "N"
		if ($mergeChoice.ToUpperInvariant() -eq "Y") {
			if (Test-Path $existingBackup -PathType Container) {
				Copy-Item -Path (Join-Path $existingBackup "*") -Destination $ExistingPath -Recurse -Force -ErrorAction Stop
				Write-Ok "Merged backup contents into linked $Label folder."
			}
			else {
				Write-WarnMsg "Backup folder not found: $existingBackup"
			}
		}
		return $false
	}

	if (-not (Test-Path $TargetPath -PathType Container)) {
		Write-WarnMsg "$Label target path does not exist: $TargetPath"
		return $false
	}

	$backupPath = Get-UniqueBackupPath $ExistingPath
	Rename-Item -LiteralPath $ExistingPath -NewName (Split-Path -Leaf $backupPath) -ErrorAction Stop
	Write-Ok "$Label folder backed up to $backupPath"

	try {
		$linkTypeUsed = "SymbolicLink"
		try {
			New-Item -ItemType SymbolicLink -Path $ExistingPath -Target $TargetPath -ErrorAction Stop | Out-Null
		}
		catch {
			Write-WarnMsg "Symbolic link creation failed for $Label; trying directory junction instead."
			New-Item -ItemType Junction -Path $ExistingPath -Target $TargetPath -ErrorAction Stop | Out-Null
			$linkTypeUsed = "Junction"
		}
		Write-Ok "$Label folder now links to $TargetPath ($linkTypeUsed)"
		$mergeChoice = if ($Label -eq "RetroBat ROMs") {
			Write-Info "Skipping ROM backup merge (temporarily disabled)."
			"N"
		}
		else {
			Prompt-WithDefault "Merge files from '$backupPath' into linked '$ExistingPath'? (Y/N)" "Y"
		}
		if ($mergeChoice.ToUpperInvariant() -eq "Y") {
			try {
				$copied = Copy-DirectoryContentsWithProgress -SourceDir $backupPath -DestinationDir $ExistingPath -ActivityLabel $Label
				Write-Ok "Merged backup contents into linked $Label folder. Files copied: $copied"
			}
			catch {
				Write-WarnMsg "Merge skipped for ${Label}: $($_.Exception.Message)"
			}
		}
		return $true
	}
	catch {
		Write-ErrMsg "Failed to create symlink for ${Label}: $($_.Exception.Message)"
		if (-not (Test-Path $ExistingPath) -and (Test-Path $backupPath)) {
			Rename-Item -LiteralPath $backupPath -NewName (Split-Path -Leaf $ExistingPath) -ErrorAction SilentlyContinue
		}
		throw
	}
}

function Configure-RetroBatDriveLinks([string]$RetroBatDir, [string]$RetroBatDriveRoot, [string]$RetroBatRemotePath = "") {
	$romsPath = Join-Path $RetroBatDir "roms"
	$biosPath = Join-Path $RetroBatDir "bios"
	$romsTarget = Join-Path $RetroBatDriveRoot "ROMS"
	$biosTarget = Join-Path $RetroBatDriveRoot "bios"
	$romsTargetForElevation = if (-not [string]::IsNullOrWhiteSpace($RetroBatRemotePath)) { Join-Path $RetroBatRemotePath "ROMS" } else { $romsTarget }
	$biosTargetForElevation = if (-not [string]::IsNullOrWhiteSpace($RetroBatRemotePath)) { Join-Path $RetroBatRemotePath "bios" } else { $biosTarget }
	$retroarchSystemPath = Join-Path $RetroBatDir "emulators\retroarch\system"
	$retroarchSystemTarget = $biosTarget
	$retroarchSystemTargetForElevation = $biosTargetForElevation

	Write-Host ""
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host "RetroBat Folder Link Setup (Optional)" -ForegroundColor Cyan
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host ""
	Write-Host "This will check your RetroBat installation for local 'roms' and 'bios' folders." -ForegroundColor Gray
	Write-Host "If they are normal directories, each will be renamed to '<name>_bak' and replaced" -ForegroundColor Gray
	Write-Host "with a symbolic link to the mapped TransFS RetroBat drive." -ForegroundColor Gray
	Write-Host ""
	Write-Host "  ROMs target: $romsTarget" -ForegroundColor Gray
	Write-Host "  BIOS target: $biosTarget" -ForegroundColor Gray
	Write-Host "  RetroArch system target (optional): $retroarchSystemTarget" -ForegroundColor Gray
	Write-Info "RetroBat link debug: admin=$([bool](Test-IsAdministrator))"
	Write-Info "RetroBat link debug: romsPath=$romsPath"
	Write-Info "RetroBat link debug: biosPath=$biosPath"
	Write-Info "RetroBat link debug: retroarchSystemPath=$retroarchSystemPath"
	if (-not [string]::IsNullOrWhiteSpace($RetroBatRemotePath)) {
		Write-Info "RetroBat link debug: elevated targets use UNC root $RetroBatRemotePath"
	}
	Write-Host ""

	$proceed = Prompt-WithDefault "Replace local RetroBat roms/bios folders with symlinks? (Y/N)" "Y"
	if ($proceed.ToUpperInvariant() -ne "Y") {
		Write-Info "Skipped RetroBat folder link setup."
		return $false
	}

	Write-Host ""
	$linkRetroArchSystem = (Prompt-WithDefault "Also link RetroArch system folder ($retroarchSystemPath) to BIOS target? (Y/N)" "N").ToUpperInvariant() -eq "Y"
	$retroarchSystemPathForSetup = if ($linkRetroArchSystem) { $retroarchSystemPath } else { "" }
	$retroarchSystemTargetForSetup = if ($linkRetroArchSystem) { $retroarchSystemTargetForElevation } else { "" }

	if (-not (Test-IsAdministrator)) {
		Write-Info "Not running as Administrator. Proper symbolic links require elevation (or Developer Mode policy)."
		$useElevation = Prompt-WithDefault "Use UAC elevation to create proper symbolic links? (Y/N)" "Y"
		if ($useElevation.ToUpperInvariant() -eq "Y") {
			$mergeRoms = "N"
			Write-Info "ROM backup merge is temporarily disabled (writes should target the Native share layout)."
			$mergeBios = Prompt-WithDefault "After linking, merge BIOS backup into linked folder? (Y/N)" "Y"

			$elevatedResult = Invoke-ElevatedRetroBatLinkSetup `
				-RomsPath $romsPath `
				-RomsTarget $romsTargetForElevation `
				-BiosPath $biosPath `
				-BiosTarget $biosTargetForElevation `
				-MergeRomsChoice $mergeRoms `
				-MergeBiosChoice $mergeBios `
				-RetroArchSystemPath $retroarchSystemPathForSetup `
				-RetroArchSystemTarget $retroarchSystemTargetForSetup

			if ($elevatedResult.success -and $elevatedResult.changed) {
				$script:RestartExplorerAfterExit = $true
			}

			if ($elevatedResult.success) {
				return [bool]$elevatedResult.changed
			}

			$fallback = Prompt-WithDefault "Elevation did not complete successfully. Fallback to junction links without admin? (Y/N)" "N"
			if ($fallback.ToUpperInvariant() -ne "Y") {
				Write-Info "Skipped fallback link setup."
				return $false
			}
		}

		Write-Info "Proceeding without elevation. Will use directory junction fallback when symbolic links are blocked."
	}

	$changed = $false
	$changed = (Replace-DirectoryWithSymlink -ExistingPath $RomsPath -TargetPath $RomsTarget -Label "RetroBat ROMs" -MergeDefault "N") -or $changed
	$changed = (Replace-DirectoryWithSymlink -ExistingPath $BiosPath -TargetPath $BiosTarget -Label "RetroBat BIOS" -MergeDefault "Y") -or $changed
	if ($linkRetroArchSystem) {
		$changed = (Replace-DirectoryWithSymlink -ExistingPath $retroarchSystemPath -TargetPath $retroarchSystemTarget -Label "RetroArch system" -MergeDefault "N") -or $changed
	}

	if ($changed) {
		$script:RestartExplorerAfterExit = $true
	}

	return $changed
}

try {
	Write-Host ""
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host "        TransFS Windows Setup - N:/R:/M: Drive Mapping         " -ForegroundColor White
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host ""
	Write-Info "This script will configure optional drive mappings for TransFS:"
	Write-Host "  â€¢ N: â†’ Native filestore (bypass, direct access)" -ForegroundColor Gray
	Write-Host "  â€¢ R: â†’ RetroBat virtual filesystem (if installed)" -ForegroundColor Gray
	Write-Host "  â€¢ M: â†’ MAME virtual filesystem (if installed)" -ForegroundColor Gray
	Write-Host ""

	Write-Info "Loading saved settings..."
	$defaults = Get-StoredSettings
	
	if ($defaults['ServerName']) {
		Write-Info "Found saved server: $($defaults['ServerName']):$($defaults['SmbPort'])"
	}

	# Step 1: Get connection configuration
	Write-Info "Collecting connection parameters..."
	$connectionConfig = $null
	while (-not $connectionConfig) {
		$connectionConfig = Get-ConnectionConfig -Defaults $defaults
		if (-not $connectionConfig) {
			Write-WarnMsg "Connection configuration failed. Please try again."
			Write-Host ""
		}
	}

	Write-Ok "Connection configured: $($connectionConfig.ServerName):$($connectionConfig.SmbPort)"

	# Step 2: Offer Native mapping (optional)
	$nativeMapping = Offer-NativeMapping -ConnectionConfig $connectionConfig -Defaults $defaults

	# Step 3: Offer RetroBat mapping (optional, detection-based)
	$retroBatMapping = Offer-RetroBatMapping -ConnectionConfig $connectionConfig -Defaults $defaults
	$retroBatLinkMapping = $retroBatMapping

	# Step 4: Offer MAME mapping (optional, detection-based)
	$mameMapping = Offer-MameMapping -ConnectionConfig $connectionConfig -Defaults $defaults

	if (-not $retroBatLinkMapping) {
		$retroBatDirForLinks = Get-RetroBatInstallDir
		if ($retroBatDirForLinks) {
			Write-Host ""
			$runLinkOnly = Prompt-WithDefault "Configure RetroBat symlinks only (without creating/changing mappings)? (Y/N)" "Y"
			if ($runLinkOnly.ToUpperInvariant() -eq "Y") {
				$retroBatLinkMapping = Resolve-RetroBatLinkMapping -Defaults $defaults -ConnectionConfig $connectionConfig -RetroBatDir $retroBatDirForLinks
				if ($retroBatLinkMapping) {
					Write-Ok "Using existing $($retroBatLinkMapping.DriveLetter): mapping for RetroBat symlink setup."
				}
				else {
					Write-WarnMsg "No existing RetroBat mapped drive was detected for symlink setup."
					Write-Info "Map RetroBat to a drive letter (for example R:) and rerun setup, or allow RetroBat mapping in this run."
				}
			}
			else {
				Write-Info "Skipped RetroBat symlink setup."
			}
		}
	}

	# Save settings
	$settingsToSave = @{
		ServerName = $connectionConfig.ServerName
		SmbPort = [string]$connectionConfig.SmbPort
		MappingScope = $connectionConfig.MappingScope
	}

	if ($nativeMapping) {
		$settingsToSave['NativeDriveLetter'] = $nativeMapping.DriveLetter
		$settingsToSave['NativeShareRoot'] = $nativeMapping.DriveRoot
	}
	if ($retroBatMapping) {
		$settingsToSave['RetroBatDriveLetter'] = $retroBatMapping.DriveLetter
		$settingsToSave['ShareRoot'] = $retroBatMapping.DriveRoot
	}
	if ($mameMapping) {
		$settingsToSave['MameDriveLetter'] = $mameMapping.DriveLetter
	}

	Save-StoredSettings -Settings $settingsToSave
	Write-Ok "Saved settings to registry: HKCU\Software\TransFS\RetroBatSync"

	# Step 5: Handle RetroBat BIOS copy if RetroBat was mapped
	if ($script:EnableLegacyRetroBatBiosCopy -and $retroBatMapping -and $nativeMapping) {
		Write-Host ""
		Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
		Write-Host "RetroBat BIOS Setup (Optional)" -ForegroundColor Cyan
		Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
		Write-Host ""
		Write-Info "For network BIOSes to work, we can copy files from your local RetroBat"
		Write-Info "installation to the Native filestore and update RetroBat's config."
		Write-Host ""

		$targetBiosDir = Join-Path $nativeMapping.DriveRoot "Clients\RetroBat\bios"
		$biosAlreadyExists = Test-Path $targetBiosDir -PathType Container

		if ($biosAlreadyExists) {
			Write-Info "BIOS folder already exists: $targetBiosDir"
			Write-Info ""
			$proceedWithBios = Prompt-WithDefault "Copy/update BIOS files from local RetroBat? (Y/N)" "N"
		}
		else {
			$proceedWithBios = Prompt-WithDefault "Copy BIOS files from local RetroBat to network? (Y/N)" "Y"
		}

		if ($proceedWithBios.ToUpperInvariant() -eq "Y") {
			$retroBatDir = $retroBatMapping['RetroBatDir']
			$sourceBiosDir = Join-Path $retroBatDir "bios"
			
			if (-not (Test-Path $sourceBiosDir -PathType Container)) {
				Write-WarnMsg "RetroBat BIOS folder not found: $sourceBiosDir"
			}
			else {
				Write-Info "Preparing target BIOS folder..."
				try {
					New-Item -Path $targetBiosDir -ItemType Directory -Force | Out-Null
				}
				catch {
					throw "Failed to create BIOS folder: $targetBiosDir. $($_.Exception.Message)"
				}

				if (-not (Test-PathWritable $targetBiosDir)) {
					Write-WarnMsg "Target BIOS folder is not writable: $targetBiosDir"
				}
				else {
					Write-Info "Copying BIOS files (this may take a few moments)..."
					Write-Info "  From: $sourceBiosDir"
					Write-Info "  To:   $targetBiosDir"
					Write-Host ""

					Copy-BiosWithProgress -SourceDir $sourceBiosDir -DestinationDir $targetBiosDir

					$srcCount = (Get-ChildItem -Path $sourceBiosDir -Recurse -File).Count
					$dstCount = (Get-ChildItem -Path $targetBiosDir -Recurse -File).Count

					if ($dstCount -ge $srcCount) {
						Write-Ok "Copy verified. Files: $srcCount â†’ $dstCount"
					}
					else {
						Write-WarnMsg "Copy may be incomplete. Source: $srcCount, Destination: $dstCount"
					}

					# Trigger database sync
					Write-Host ""
					Write-Info "Triggering database sync for RetroBat..."
					try {
						$apiUrl = "http://$($connectionConfig.ServerName):8000/api/db/sync?client=RetroBat"
						$response = Invoke-RestMethod -Uri $apiUrl -Method Post -TimeoutSec 300 -ErrorAction Stop

						if ($response.success) {
							Write-Ok "Database sync completed"
							if ($response.stats) {
								Write-Host "  Files added: $($response.stats.files_added)" -ForegroundColor Gray
								Write-Host "  Files updated: $($response.stats.files_updated)" -ForegroundColor Gray
							}
						}
						else {
							Write-WarnMsg "Sync returned: $($response.message)"
						}
					}
					catch {
						Write-WarnMsg "Failed to trigger sync automatically: $($_.Exception.Message)"
						Write-Info "You can run a manual sync from the TransFS web UI."
					}

					# Update RetroBat config
					Write-Host ""
					$biosPathForConfig = Join-Path $retroBatMapping.DriveRoot "bios"
					$updateConfig = Prompt-WithDefault "Update RetroBat config to use '$biosPathForConfig'? (Y/N)" "Y"
					if ($updateConfig.ToUpperInvariant() -eq "Y") {
						Update-RetroBatConfig -RetroBatDir $retroBatDir -BiosPath $biosPathForConfig
						
						# Offer ROM path update
						Write-Host ""
						$updateRomPaths = Prompt-WithDefault "Update ROM paths in es_systems.cfg to use Native drive? (Y/N)" "Y"
						if ($updateRomPaths.ToUpperInvariant() -eq "Y") {
							Write-Info "Updating ROM paths..."
							Write-Host ""
							$pathsUpdated = Update-RomPaths -RetroBatDir $retroBatDir -NativeDriveLetter $nativeMapping.DriveLetter
							if ($pathsUpdated) {
								Write-Host ""
							}
						}
						else {
							Write-Info "Skipped ROM path update."
						}
					}
					else {
						Write-Info "Skipped config update."
					}
				}
			}
		}
		else {
			Write-Info "Skipped BIOS copy."
		}
	}
	elseif (-not $script:EnableLegacyRetroBatBiosCopy -and $retroBatMapping) {
		Write-Info "Skipping legacy RetroBat BIOS copy/update flow (disabled while symlink mode is active)."
	}
	elseif ($script:EnableLegacyRetroBatBiosCopy -and $retroBatMapping -and -not $nativeMapping) {
		Write-Host ""
		Write-WarnMsg "RetroBat mapped but Native drive not available."
		Write-Info "BIOS copy requires Native mapping (N:) for direct filestore access."
		Write-Info "Re-run this script and accept Native mapping to enable BIOS copy."
	}

	if ($retroBatLinkMapping) {
		Write-Host ""
		Configure-RetroBatDriveLinks -RetroBatDir $retroBatLinkMapping['RetroBatDir'] -RetroBatDriveRoot $retroBatLinkMapping.DriveRoot -RetroBatRemotePath $retroBatLinkMapping.RemotePath | Out-Null
	}

	Write-Host ""
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor Green
	Write-Host "                        Setup Complete                         " -ForegroundColor Green
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor Green
	Write-Host ""
	
	if ($nativeMapping) {
		Write-Ok "$($nativeMapping.DriveLetter): â†’ Native filestore"
	}
	if ($retroBatMapping) {
		Write-Ok "$($retroBatMapping.DriveLetter): â†’ RetroBat virtual filesystem"
	}
	if ($mameMapping) {
		Write-Ok "$($mameMapping.DriveLetter): â†’ MAME virtual filesystem"
	}
	
	Write-Host ""
	if ($script:RestartExplorerAfterExit) {
		Write-Info "Explorer restart is queued and will run when you close this window."
	}
	Write-Info "Press any key to exit..."
	$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
	Invoke-PendingExplorerRestart
}
catch {
	Write-Host ""
	Write-ErrMsg $_.Exception.Message
	Write-Host ""
	Write-Info "Press any key to exit..."
	$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
	exit 1
}




