function Offer-RetroBatMapping([hashtable]$ConnectionConfig, [hashtable]$Defaults) {
	$retroBatDir = Get-RetroBatInstallDir
	
	if (-not $retroBatDir) {
		Write-Info "RetroBat installation not detected - skipping R: mapping."
		return $null
	}

	Write-Host ""
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host "RetroBat Mapping Detected" -ForegroundColor Cyan
	Write-Host "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•" -ForegroundColor White
	Write-Host ""
	Write-Host "Detected RetroBat installation: $retroBatDir" -ForegroundColor Green
	Write-Host ""
	Write-Host "This will:" -ForegroundColor Yellow
	Write-Host "  â€¢ Map R: drive to TransFS /RetroBat virtual filesystem" -ForegroundColor Gray
	Write-Host "  â€¢ Optionally copy shared BIOS files to the network" -ForegroundColor Gray
	Write-Host "  â€¢ Update RetroBat config to use the network BIOS path" -ForegroundColor Gray
	Write-Host ""

	$defaultDrive = if ($Defaults['RetroBatDriveLetter']) { [string]$Defaults['RetroBatDriveLetter'] } else { "R" }
	$mapRetroBat = Prompt-WithDefault "Map RetroBat to R: drive? (Y/N)" "Y"
	
	if ($mapRetroBat.ToUpperInvariant() -ne "Y") {
		Write-Info "Skipped RetroBat mapping."
		return $null
	}

	$driveLetter = Prompt-WithDefault "Drive letter for RetroBat" $defaultDrive
	
	$mapping = New-TransFSDriveMapping `
		-DriveLetter $driveLetter `
		-VirtualPath "RetroBat" `
		-ConnectionConfig $ConnectionConfig `
		-DefaultShareName "$DefaultShareName\RetroBat"

	if ($mapping) {
		$mapping['RetroBatDir'] = $retroBatDir
		Restart-ExplorerIfRequested
	}

	return $mapping
}

function Resolve-RetroBatLinkMapping([hashtable]$Defaults, [hashtable]$ConnectionConfig, [string]$RetroBatDir) {
	$candidateLetters = @()
	if ($Defaults['RetroBatDriveLetter']) {
		$candidateLetters += [string]$Defaults['RetroBatDriveLetter']
	}
	$candidateLetters += 'R'

	$candidateLetters = @(
		$candidateLetters |
			Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) } |
			ForEach-Object { [string]$_ } |
			ForEach-Object { $_.Trim().TrimEnd(':').ToUpperInvariant() } |
			Where-Object { $_ -match '^[A-Z]$' } |
			Select-Object -Unique
	)

	foreach ($driveLetter in $candidateLetters) {
		$localPath = "${driveLetter}:"
		$driveRoot = "${localPath}\"
		if (-not (Test-Path $driveRoot -PathType Container)) {
			continue
		}

		$remotePath = ""
		try {
			$smbMapping = Get-SmbMapping -LocalPath $localPath -ErrorAction Stop | Select-Object -First 1
			if ($smbMapping -and $smbMapping.RemotePath) {
				$remotePath = [string]$smbMapping.RemotePath
			}
		}
		catch {
			$remotePath = ""
		}

		if ([string]::IsNullOrWhiteSpace($remotePath)) {
			$remotePath = "\\$($ConnectionConfig.ServerName)\$DefaultShareName\RetroBat"
		}

		return @{
			DriveLetter = $driveLetter
			LocalPath = $localPath
			RemotePath = $remotePath
			DriveRoot = $driveRoot
			VirtualPath = 'RetroBat'
			RetroBatDir = $RetroBatDir
		}
	}

	return $null
}

