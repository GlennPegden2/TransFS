<# 
=============================================================================
TransFS RetroBat Shared BIOS Copy Setup Script
=============================================================================

This script automates the setup of RetroBat BIOS files on a TransFS share.

DEFAULT CONFIGURATION (resolved by TransFS setup profile):
  • SMB Server Host:     {{TRANSFS_SMB_HOST}}
  • SMB Server Username: {{TRANSFS_SMB_USERNAME}}
  • SMB Server Port:     {{TRANSFS_SMB_PORT}}
  • Default Share Name:  {{TRANSFS_SHARE_NAME}}

USAGE:
  1. Download this script to your Windows machine
  2. Open PowerShell as Administrator
  3. Run: .\setup_windows.ps1
  4. Follow the on-screen prompts

For more information, visit your TransFS web UI at:
  http://transfs.local:8000/
  
=============================================================================
#>

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$RegistryRoot = "HKCU:\Software\TransFS\RetroBatSync"

# Configuration defaults (from TransFS setup profile)
$DefaultSmbHost = "{{TRANSFS_SMB_HOST}}"
$DefaultSmbUsername = "{{TRANSFS_SMB_USERNAME}}"
$DefaultSmbPort = "{{TRANSFS_SMB_PORT}}"
$DefaultShareName = "{{TRANSFS_SHARE_NAME}}"
$DefaultNativeShareName = "{{TRANSFS_NATIVE_SHARE_NAME}}"
$script:RestartExplorerAfterExit = $false

function Write-Info([string]$Message) { Write-Host "[INFO] $Message" -ForegroundColor Cyan }
function Write-Ok([string]$Message) { Write-Host "[ OK ] $Message" -ForegroundColor Green }
function Write-WarnMsg([string]$Message) { Write-Host "[WARN] $Message" -ForegroundColor Yellow }
function Write-ErrMsg([string]$Message) { Write-Host "[ERR ] $Message" -ForegroundColor Red }

function Get-StoredSettings {
	$result = @{}
	
	if (-not (Test-Path $RegistryRoot)) {
		return $result
	}

	try {
		$props = Get-ItemProperty -Path $RegistryRoot -ErrorAction SilentlyContinue
		if (-not $props) {
			return $result
		}
		
		# Safely access each property using PSObject.Properties
		$propNames = @('Mode', 'ShareRoot', 'DriveLetter', 'ServerName', 'ShareName', 'SmbPort', 'MappingScope', 'NativeShareRoot', 'NativeDriveLetter', 'NativeShareName')
		foreach ($propName in $propNames) {
			$propValue = $props.PSObject.Properties.Item($propName)
			if ($propValue -ne $null) {
				$result[$propName] = $propValue.Value
			}
		}
	}
	catch {
		# If any error occurs reading registry, return empty defaults
		return $result
	}

	return $result
}

function Save-StoredSettings([hashtable]$Settings) {
	if (-not (Test-Path $RegistryRoot)) {
		New-Item -Path $RegistryRoot -Force | Out-Null
	}

	foreach ($key in $Settings.Keys) {
		New-ItemProperty -Path $RegistryRoot -Name $key -Value $Settings[$key] -PropertyType String -Force | Out-Null
	}
}

function Prompt-WithDefault([string]$Prompt, [string]$Default = "") {
	if ([string]::IsNullOrWhiteSpace($Default)) {
		return Read-Host $Prompt
	}

	$value = Read-Host "$Prompt [$Default]"
	if ([string]::IsNullOrWhiteSpace($value)) {
		return $Default
	}
	return $value
}

function Restart-ExplorerIfRequested() {
	Write-Info "[CHECKPOINT] Restart-ExplorerIfRequested called"
	Write-Info ""
	Write-Info "For the new mapped drive to be visible in Windows Explorer, it needs to be restarted."
	$restartChoice = Prompt-WithDefault "Restart Windows Explorer after setup completes? (Y/N)" "N"
	if ($restartChoice.ToUpperInvariant() -ne "Y") {
		Write-Info "[CHECKPOINT] User declined Explorer restart"
		return
	}

	$script:RestartExplorerAfterExit = $true
	Write-Ok "Explorer restart queued for script completion."
	Write-Info "[CHECKPOINT] Explorer restart queued for end-of-script"
}

function Invoke-PendingExplorerRestart() {
	if (-not $script:RestartExplorerAfterExit) {
		return
	}

	try {
		Write-Info "[CHECKPOINT] Scheduling Explorer restart after script exit"
		$cmd = 'Start-Sleep -Seconds 1; Get-Process explorer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 800; Start-Process explorer.exe | Out-Null'
		Start-Process -FilePath "powershell.exe" -ArgumentList @("-NoProfile", "-WindowStyle", "Hidden", "-Command", $cmd) | Out-Null
		Write-Ok "Explorer restart scheduled."
		Write-Info "[CHECKPOINT] Explorer restart scheduled in detached process"
	}
	catch {
		Write-WarnMsg "Failed to schedule Explorer restart: $($_.Exception.Message)"
		Write-WarnMsg "You can restart Explorer manually from Task Manager if needed."
		Write-Info "[CHECKPOINT] Explorer restart scheduling failed"
	}
}

function Get-TransFSCredential([string]$DefaultUserName) {
	$creds = $null
	try {
		$creds = Get-Credential -Message "Enter TransFS SMB credentials" -UserName $DefaultUserName
	}
	catch {
		$creds = $null
	}

	if ($creds) {
		return $creds
	}

	Write-WarnMsg "Credential dialog unavailable/cancelled. Falling back to console credential entry."
	$username = Prompt-WithDefault "Enter SMB username" $DefaultUserName
	if ([string]::IsNullOrWhiteSpace($username)) {
		return $null
	}

	$securePassword = Read-Host "Enter SMB password" -AsSecureString
	if (-not $securePassword) {
		return $null
	}

	try {
		return New-Object System.Management.Automation.PSCredential($username, $securePassword)
	}
	catch {
		return $null
	}
}

function Remove-StaleSmbMappings([string]$LocalPath, [string]$RemotePath) {
	try {
		$existingMappings = @(Get-SmbMapping -ErrorAction SilentlyContinue | Where-Object {
			$_.LocalPath -eq $LocalPath -or $_.RemotePath -eq $RemotePath
		})

		foreach ($mapping in $existingMappings) {
			Write-Info "Removing existing SMB mapping: $($mapping.LocalPath) -> $($mapping.RemotePath)"
			Remove-SmbMapping -LocalPath $mapping.LocalPath -Force -UpdateProfile -ErrorAction SilentlyContinue | Out-Null
		}
	}
	catch {
		Write-WarnMsg "Could not fully clear previous SMB mappings. Continuing with new mapping attempt."
	}
}

function New-TransFSSmbMappingWithFallback(
	[string]$LocalPath,
	[string]$RemotePath,
	[int]$SmbPort,
	[pscredential]$Credential,
	[bool]$UseGlobalMapping,
	[string]$ServerName,
	[string]$DefaultUserName
) {
	$userCandidates = @(
		$Credential.UserName,
		$DefaultUserName,
		"$ServerName\$DefaultUserName",
		".\$DefaultUserName"
	) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique

	$lastError = $null

	foreach ($candidateUser in $userCandidates) {
		$attemptCredential = $Credential
		if ($candidateUser -ne $Credential.UserName) {
			$attemptCredential = New-Object System.Management.Automation.PSCredential($candidateUser, $Credential.Password)
		}

		try {
			Write-Info "Trying SMB authentication as '$candidateUser'"
			if ($UseGlobalMapping) {
				New-SmbMapping -LocalPath $LocalPath -RemotePath $RemotePath -TcpPort $SmbPort -Credential $attemptCredential -Persistent $true -GlobalMapping -ErrorAction Stop | Out-Null
			}
			else {
				New-SmbMapping -LocalPath $LocalPath -RemotePath $RemotePath -TcpPort $SmbPort -Credential $attemptCredential -Persistent $true -ErrorAction Stop | Out-Null
			}

			Write-Ok "Successfully authenticated as '$candidateUser'"
			return
		}
		catch {
			$lastError = $_
			$errorText = "$_"
			$errorMsg = $_.Exception.Message
			$errorId = $_.FullyQualifiedErrorId
			
			# Check multiple error properties for authentication failures
			if ($errorText -match 'Access is denied|Denied|0x80070005|Logon failure|Authentication|1326' -or
			    $errorMsg -match 'Access is denied|Denied|0x80070005|Logon failure|Authentication|1326' -or
			    $errorId -match 'Access is denied|Denied|0x80070005|Logon failure|Authentication|1326') {
				Write-WarnMsg "Authentication failed for '$candidateUser'. Trying next credential format..."
				continue
			}
			
			# For other errors, throw immediately
			Write-ErrMsg "Unexpected error with '$candidateUser': $errorText"
			throw
		}
	}

	if ($lastError) {
		throw $lastError
	}
}

function Select-FolderDialog([string]$Description, [string]$InitialPath = "") {
	Add-Type -AssemblyName System.Windows.Forms | Out-Null
	$dialog = New-Object System.Windows.Forms.FolderBrowserDialog
	$dialog.Description = $Description
	if (-not [string]::IsNullOrWhiteSpace($InitialPath) -and (Test-Path $InitialPath)) {
		$dialog.SelectedPath = $InitialPath
	}

	$result = $dialog.ShowDialog()
	if ($result -eq [System.Windows.Forms.DialogResult]::OK) {
		return $dialog.SelectedPath
	}
	return $null
}

function Test-PathWritable([string]$PathToTest) {
	try {
		if (-not (Test-Path $PathToTest -PathType Container)) {
			return $false
		}
		$testFile = Join-Path $PathToTest ("transfs_write_test_" + [guid]::NewGuid().ToString("N") + ".tmp")
		Set-Content -Path $testFile -Value "ok" -Encoding UTF8
		Remove-Item -Path $testFile -Force
		return $true
	}
	catch {
		return $false
	}
}

function Test-DriveLetterAvailable([string]$Letter) {
	$normalized = $Letter.Trim().TrimEnd(':').ToUpperInvariant()
	if ($normalized -notmatch '^[A-Z]$') {
		return $false
	}

	$drive = Get-PSDrive -Name $normalized -ErrorAction SilentlyContinue
	return $null -eq $drive
}

function Ensure-DriveLetterAvailableOrOfferRemoval([string]$Letter) {
	$normalized = $Letter.Trim().TrimEnd(':').ToUpperInvariant()
	if ($normalized -notmatch '^[A-Z]$') {
		Write-ErrMsg "Drive letter is invalid: $Letter"
		return $false
	}

	$localPath = "${normalized}:"
	$drive = Get-PSDrive -Name $normalized -ErrorAction SilentlyContinue
	if ($null -eq $drive) {
		return $true
	}

	$smbMapping = Get-SmbMapping -ErrorAction SilentlyContinue | Where-Object { $_.LocalPath -eq $localPath } | Select-Object -First 1
	if ($null -eq $smbMapping) {
		Write-ErrMsg "Drive letter is already in use and is not an SMB mapping: $localPath"
		return $false
	}

	Write-WarnMsg "Drive letter already mapped: $localPath -> $($smbMapping.RemotePath)"
	$removeChoice = Prompt-WithDefault "Remove this existing mapping before continuing? (Y/N)" "Y"
	if ($removeChoice.ToUpperInvariant() -ne "Y") {
		Write-Info "Keeping existing mapping. Choose another drive letter to continue."
		return $false
	}

	try {
		Remove-SmbMapping -LocalPath $localPath -Force -UpdateProfile -ErrorAction Stop | Out-Null
		Start-Sleep -Milliseconds 250
		Write-Ok "Removed existing mapping: $localPath"
	}
	catch {
		Write-ErrMsg "Failed to remove existing mapping ${localPath}: $($_.Exception.Message)"
		return $false
	}

	$driveAfter = Get-PSDrive -Name $normalized -ErrorAction SilentlyContinue
	if ($null -ne $driveAfter) {
		Write-ErrMsg "Drive letter is still in use after removal attempt: $localPath"
		return $false
	}

	return $true
}

function Get-RetroBatInstallDir {
	$regCandidates = @(
		@{ Hive = "HKLM:"; SubKey = "SOFTWARE\RetroBat" },
		@{ Hive = "HKLM:"; SubKey = "SOFTWARE\WOW6432Node\RetroBat" },
		@{ Hive = "HKCU:"; SubKey = "SOFTWARE\RetroBat" }
	)

	foreach ($candidate in $regCandidates) {
		$keyPath = Join-Path $candidate.Hive $candidate.SubKey
		if (Test-Path $keyPath) {
			$item = Get-ItemProperty -Path $keyPath
			foreach ($name in @("InstallPath", "RootPath", "Path")) {
				if ($item.PSObject.Properties.Name -contains $name) {
					$pathValue = [string]$item.$name
					if (-not [string]::IsNullOrWhiteSpace($pathValue) -and (Test-Path $pathValue)) {
						if (Test-Path (Join-Path $pathValue "emulationstation\emulatorLauncher.cfg")) {
							return $pathValue
						}
					}
				}
			}
		}
	}

	$fallbacks = @("C:\RetroBat", "D:\RetroBat", "E:\Games\RetroBat", "E:\RetroBat")
	foreach ($path in $fallbacks) {
		if (Test-Path (Join-Path $path "emulationstation\emulatorLauncher.cfg")) {
			return $path
		}
	}

	return $null
}

function Get-MameInstallDir {
	# Check registry for standalone MAME installations
	$regCandidates = @(
		@{ Hive = "HKLM:"; SubKey = "SOFTWARE\MAME" },
		@{ Hive = "HKLM:"; SubKey = "SOFTWARE\WOW6432Node\MAME" },
		@{ Hive = "HKCU:"; SubKey = "SOFTWARE\MAME" }
	)

	foreach ($candidate in $regCandidates) {
		$keyPath = Join-Path $candidate.Hive $candidate.SubKey
		if (Test-Path $keyPath) {
			$item = Get-ItemProperty -Path $keyPath
			foreach ($name in @("InstallPath", "RootPath", "Path")) {
				if ($item.PSObject.Properties.Name -contains $name) {
					$pathValue = [string]$item.$name
					if (-not [string]::IsNullOrWhiteSpace($pathValue) -and (Test-Path $pathValue)) {
						# Look for mame.exe or mame64.exe
						if ((Test-Path (Join-Path $pathValue "mame.exe")) -or (Test-Path (Join-Path $pathValue "mame64.exe"))) {
							return $pathValue
						}
					}
				}
			}
		}
	}

	# Common fallback paths for standalone MAME
	$fallbacks = @("C:\MAME", "D:\MAME", "C:\Games\MAME", "D:\Games\MAME", "E:\MAME", "C:\Program Files\MAME", "C:\Program Files (x86)\MAME")
	foreach ($path in $fallbacks) {
		if ((Test-Path (Join-Path $path "mame.exe")) -or (Test-Path (Join-Path $path "mame64.exe"))) {
			return $path
		}
	}

	return $null
}

function Get-ConnectionConfig([hashtable]$Defaults) {
	# Simplified connection configuration - just collect server, port, username
	if (-not $Defaults) {
		$Defaults = @{}
	}
	
	Write-Host ""
	Write-Host "TransFS Connection Configuration" -ForegroundColor White
	Write-Host "================================" -ForegroundColor White
	Write-Info "Enter connection details for your TransFS SMB server"
	Write-Host ""

	$defaultServerName = if ($Defaults.ContainsKey("ServerName") -and -not [string]::IsNullOrWhiteSpace([string]$Defaults['ServerName'])) { [string]$Defaults['ServerName'] } else { $DefaultSmbHost }
	$defaultSmbPort = if ($Defaults.ContainsKey("SmbPort") -and -not [string]::IsNullOrWhiteSpace([string]$Defaults['SmbPort'])) { [string]$Defaults['SmbPort'] } else { $DefaultSmbPort }
	$defaultMappingScope = if ($Defaults.ContainsKey("MappingScope") -and -not [string]::IsNullOrWhiteSpace([string]$Defaults['MappingScope'])) { [string]$Defaults['MappingScope'] } else { "1" }

	$serverName = Prompt-WithDefault "SMB server hostname/IP" $defaultServerName
	$smbPort = Prompt-WithDefault "SMB TCP port" $defaultSmbPort

	if ($smbPort -notmatch '^[0-9]+$') {
		Write-ErrMsg "Port must be numeric."
		return $null
	}

	Write-Host ""
	Write-Host "Select mapping scope:" -ForegroundColor White
	Write-Host "  1) Current user only (recommended, no admin required)" -ForegroundColor White
	Write-Host "  2) All users (requires running PowerShell as Administrator)" -ForegroundColor White
	$mappingScope = Prompt-WithDefault "Choose 1/2" $defaultMappingScope
	if ($mappingScope -notin @('1', '2')) {
		Write-ErrMsg "Invalid mapping scope. Choose 1 or 2."
		return $null
	}

	Write-Host ""
	Write-Host "Credentials Required" -ForegroundColor Cyan
	Write-Host "  - TransFS SMB credentials (configured in app.yaml)" -ForegroundColor Gray
	Write-Host "  - Default: $DefaultSmbUsername / <password>" -ForegroundColor Gray
	Write-Host ""
	$creds = Get-TransFSCredential -DefaultUserName $DefaultSmbUsername
	
	if (-not $creds) {
		Write-ErrMsg "Credentials required for SMB access"
		return $null
	}

	return @{
		ServerName = $serverName
		SmbPort = ([int]$smbPort)
		MappingScope = $mappingScope
		UseGlobalMapping = ($mappingScope -eq '2')
		Credential = $creds
	}
}

function New-TransFSDriveMapping(
	[string]$DriveLetter,
	[string]$VirtualPath,
	[hashtable]$ConnectionConfig,
	[string]$DefaultShareName
) {
	$driveLetter = $DriveLetter.Trim().TrimEnd(':').ToUpperInvariant()
	
	if (-not (Ensure-DriveLetterAvailableOrOfferRemoval $driveLetter)) {
		return $null
	}

	$shareName = if ($DefaultShareName) { $DefaultShareName } else { $VirtualPath }
	$remotePath = "\\$($ConnectionConfig.ServerName)\$shareName"
	$localPath = "${driveLetter}:"

	try {
		Write-Info "Mapping $localPath to $remotePath (port $($ConnectionConfig.SmbPort))"
		Remove-StaleSmbMappings -LocalPath $localPath -RemotePath $remotePath
		
		New-TransFSSmbMappingWithFallback `
			-LocalPath $localPath `
			-RemotePath $remotePath `
			-SmbPort $ConnectionConfig.SmbPort `
			-Credential $ConnectionConfig.Credential `
			-UseGlobalMapping $ConnectionConfig.UseGlobalMapping `
			-ServerName $ConnectionConfig.ServerName `
			-DefaultUserName $DefaultSmbUsername
	}
	catch {
		if ($ConnectionConfig.UseGlobalMapping -and $_.Exception.Message -match 'Access is denied|Denied|0x80070005') {
			Write-ErrMsg "All-users mapping requires local Administrator privileges."
			Write-ErrMsg "Rerun PowerShell as Administrator, or select user-only mapping scope."
			return $null
		}
		if ($_.Exception.Message -match 'Access is denied|Denied|0x80070005|Logon failure') {
			Write-ErrMsg "SMB authentication failed after trying multiple username formats."
			Write-ErrMsg "Verify TransFS SMB credentials in app.yaml and re-enter the password."
			return $null
		}
		Write-ErrMsg "Failed to map drive: $($_.Exception.Message)"
		return $null
	}

	# Verify mapping
	Write-Info "Verifying drive access..."
	Start-Sleep -Milliseconds 500

	$driveRoot = "$localPath\"
	try {
		if (-not (Test-Path $driveRoot -PathType Container -ErrorAction Stop)) {
			Write-ErrMsg "Mapped drive exists but is not accessible: $driveRoot"
			return $null
		}
	}
	catch {
		Write-ErrMsg "Cannot access mapped drive ${driveRoot}: $($_.Exception.Message)"
		return $null
	}

	Write-Ok "Successfully mapped $localPath → $remotePath"
	return @{
		DriveLetter = $driveLetter
		LocalPath = $localPath
		RemotePath = $remotePath
		DriveRoot = $driveRoot
		VirtualPath = $VirtualPath
	}
}

function Offer-NativeMapping([hashtable]$ConnectionConfig, [hashtable]$Defaults) {
	Write-Host ""
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host "Native Filestore Mapping (Optional)" -ForegroundColor Cyan
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host ""
	Write-Host "The Native mapping provides direct access to the filestore with NO virtual filesystem transforms." -ForegroundColor Gray
	Write-Host "" 
	Write-Host "Benefits:" -ForegroundColor Yellow
	Write-Host "  • Bypass mode for maximum performance" -ForegroundColor Gray
	Write-Host "  • Direct file browsing and upload" -ForegroundColor Gray
	Write-Host "  • Access to raw filestore structure" -ForegroundColor Gray
	Write-Host ""
	Write-Host "You can map this to N: (Native) or skip if you only need virtual emulator paths." -ForegroundColor Gray
	Write-Host ""

	$defaultDrive = if ($Defaults['NativeDriveLetter']) { [string]$Defaults['NativeDriveLetter'] } else { "N" }
	$mapNative = Prompt-WithDefault "Map Native filestore to N: drive? (Y/N)" "Y"
	
	if ($mapNative.ToUpperInvariant() -ne "Y") {
		Write-Info "Skipped Native mapping."
		return $null
	}

	$driveLetter = Prompt-WithDefault "Drive letter for Native" $defaultDrive
	
	$mapping = New-TransFSDriveMapping `
		-DriveLetter $driveLetter `
		-VirtualPath "Native" `
		-ConnectionConfig $ConnectionConfig `
		-DefaultShareName $DefaultNativeShareName

	if ($mapping) {
		Restart-ExplorerIfRequested
	}

	return $mapping
}

function Offer-RetroBatMapping([hashtable]$ConnectionConfig, [hashtable]$Defaults) {
	$retroBatDir = Get-RetroBatInstallDir
	
	if (-not $retroBatDir) {
		Write-Info "RetroBat installation not detected - skipping R: mapping."
		return $null
	}

	Write-Host ""
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host "RetroBat Mapping Detected" -ForegroundColor Cyan
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host ""
	Write-Host "Detected RetroBat installation: $retroBatDir" -ForegroundColor Green
	Write-Host ""
	Write-Host "This will:" -ForegroundColor Yellow
	Write-Host "  • Map R: drive to TransFS /RetroBat virtual filesystem" -ForegroundColor Gray
	Write-Host "  • Optionally copy shared BIOS files to the network" -ForegroundColor Gray
	Write-Host "  • Update RetroBat config to use the network BIOS path" -ForegroundColor Gray
	Write-Host ""

	$defaultDrive = if ($Defaults['RetroBatDriveLetter']) { [string]$Defaults['RetroBatDriveLetter'] } else { "R" }
	$mapRetroBat = Prompt-WithDefault "Map RetroBat to R: drive? (Y/N)" "Y"
	
	if ($mapRetroBat.ToUpperInvariant() -ne "Y") {
		Write-Info "Skipped RetroBat mapping."
		return $null
	}

	$driveLetter = Prompt-WithDefault "Drive letter for RetroBat" $defaultDrive
	
	$mapping = New-TransFSDriveMapping `
		-DriveLetter $driveLetter `
		-VirtualPath "RetroBat" `
		-ConnectionConfig $ConnectionConfig `
		-DefaultShareName "$DefaultShareName\RetroBat"

	if ($mapping) {
		$mapping['RetroBatDir'] = $retroBatDir
		Restart-ExplorerIfRequested
	}

	return $mapping
}

function Offer-MameMapping([hashtable]$ConnectionConfig, [hashtable]$Defaults) {
	$mameDir = Get-MameInstallDir
	
	if (-not $mameDir) {
		Write-Info "Standalone MAME installation not detected - skipping M: mapping."
		return $null
	}

	Write-Host ""
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host "MAME Mapping Detected" -ForegroundColor Cyan
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host ""
	Write-Host "Detected MAME installation: $mameDir" -ForegroundColor Green
	Write-Host ""
	Write-Host "This will map M: drive to TransFS /Mame virtual filesystem." -ForegroundColor Yellow
	Write-Host "Note: MAME paths are similar but distinct from RetroBat/lr-mame paths." -ForegroundColor Gray
	Write-Host ""

	$defaultDrive = if ($Defaults['MameDriveLetter']) { [string]$Defaults['MameDriveLetter'] } else { "M" }
	$mapMame = Prompt-WithDefault "Map MAME to M: drive? (Y/N)" "Y"
	
	if ($mapMame.ToUpperInvariant() -ne "Y") {
		Write-Info "Skipped MAME mapping."
		return $null
	}

	$driveLetter = Prompt-WithDefault "Drive letter for MAME" $defaultDrive
	
	$mapping = New-TransFSDriveMapping `
		-DriveLetter $driveLetter `
		-VirtualPath "Mame" `
		-ConnectionConfig $ConnectionConfig `
		-DefaultShareName "$DefaultShareName\Mame"

	if ($mapping) {
		$mapping['MameDir'] = $mameDir
		Restart-ExplorerIfRequested
	}

	return $mapping
}

function Copy-BiosWithProgress([string]$SourceDir, [string]$DestinationDir) {
	$files = Get-ChildItem -Path $SourceDir -Recurse -File
	if ($files.Count -eq 0) {
		throw "No files found under source BIOS directory: $SourceDir"
	}

	$index = 0
	foreach ($file in $files) {
		$index++
		$relative = $file.FullName.Substring($SourceDir.Length).TrimStart('\', '/')
		$targetPath = Join-Path $DestinationDir $relative
		$targetFolder = Split-Path -Parent $targetPath
		
		# Ensure target folder exists
		if (-not (Test-Path $targetFolder)) {
			try {
				New-Item -Path $targetFolder -ItemType Directory -Force | Out-Null
			}
			catch {
				throw "Failed to create directory '$targetFolder': $($_.Exception.Message)"
			}
		}
		
		# Check if target exists as wrong type (e.g., file when we need directory)
		if ((Test-Path $targetPath) -and (Get-Item $targetPath).PSIsContainer) {
			Write-Warn "Removing incorrectly created directory: $targetPath"
			Remove-Item $targetPath -Force -Recurse
		}

		try {
			Copy-Item -Path $file.FullName -Destination $targetPath -Force -ErrorAction Stop
		}
		catch {
			throw "Failed to copy '$($file.FullName)' to '$targetPath': $($_.Exception.Message)"
		}

		$percent = [int](($index / $files.Count) * 100)
		Write-Progress -Activity "Copying RetroBat shared BIOS files" -Status "$index / $($files.Count): $relative" -PercentComplete $percent
	}
	Write-Progress -Activity "Copying RetroBat shared BIOS files" -Completed
}

function Update-RetroBatConfig([string]$RetroBatDir, [string]$BiosPath) {
	$configPath = Join-Path $RetroBatDir "emulationstation\emulatorLauncher.cfg"
	if (-not (Test-Path $configPath)) {
		throw "Cannot find emulatorLauncher.cfg at $configPath"
	}

	$backupPath = "$configPath.transfs"
	if (-not (Test-Path $backupPath)) {
		Copy-Item -Path $configPath -Destination $backupPath -Force
		Write-Ok "Backup created: $backupPath"
	}
	else {
		Write-Info "Backup already exists: $backupPath"
	}

	$lines = Get-Content -Path $configPath
	$updated = $false
	for ($i = 0; $i -lt $lines.Count; $i++) {
		if ($lines[$i] -match '^\s*bios=') {
			$lines[$i] = "bios=$BiosPath"
			$updated = $true
			break
		}
	}

	if (-not $updated) {
		$lines = @("bios=$BiosPath") + $lines
	}

	Set-Content -Path $configPath -Value $lines -Encoding UTF8
	Write-Ok "Updated bios= in $configPath"
}

function Update-RomPaths([string]$RetroBatDir, [string]$NativeDriveLetter) {
	$esSystemsPath = Join-Path $RetroBatDir "emulationstation\.emulationstation\es_systems.cfg"
	if (-not (Test-Path $esSystemsPath)) {
		Write-Warn "Cannot find es_systems.cfg at $esSystemsPath"
		return $false
	}

	$backupPath = "$esSystemsPath.transfs"
	if (-not (Test-Path $backupPath)) {
		Copy-Item -Path $esSystemsPath -Destination $backupPath -Force
		Write-Ok "Backup created: $backupPath"
	}
	else {
		Write-Info "Backup already exists: $backupPath"
	}

	[xml]$xmlContent = Get-Content -Path $esSystemsPath -Encoding UTF8
	$updated = $false

	# Find all systemList/system/path elements
	if ($xmlContent.systemList.system) {
		foreach ($system in $xmlContent.systemList.system) {
			if ($system.path) {
				$originalPath = $system.path
				# Replace relative paths (../) with native drive mapping
				# e.g., ../roms/megadrive becomes V:\roms\megadrive
				if ($originalPath -match '^\.\.[\\/]') {
					# Convert relative paths by removing ../ or ..\ prefix (3 chars)
					$relativePart = $originalPath.Substring(3)
					$newPath = "$NativeDriveLetter\$relativePart"
					$system.path = $newPath
					$updated = $true
					Write-Info "  Updated path: $originalPath -> $newPath"
				}
			}
		}
	}

	if ($updated) {
		$xmlContent.Save($esSystemsPath)
		Write-Ok "Updated es_systems.cfg ROM paths to use $NativeDriveLetter drive"
		return $true
	}
	else {
		Write-Info "No relative paths found to update in es_systems.cfg"
		return $false
	}
}

try {
	Write-Host ""
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host "        TransFS Windows Setup - N:/R:/M: Drive Mapping         " -ForegroundColor White
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
	Write-Host ""
	Write-Info "This script will configure optional drive mappings for TransFS:"
	Write-Host "  • N: → Native filestore (bypass, direct access)" -ForegroundColor Gray
	Write-Host "  • R: → RetroBat virtual filesystem (if installed)" -ForegroundColor Gray
	Write-Host "  • M: → MAME virtual filesystem (if installed)" -ForegroundColor Gray
	Write-Host ""

	Write-Info "Loading saved settings..."
	$defaults = Get-StoredSettings
	
	if ($defaults['ServerName']) {
		Write-Info "Found saved server: $($defaults['ServerName']):$($defaults['SmbPort'])"
	}

	# Step 1: Get connection configuration
	Write-Info "Collecting connection parameters..."
	$connectionConfig = $null
	while (-not $connectionConfig) {
		$connectionConfig = Get-ConnectionConfig -Defaults $defaults
		if (-not $connectionConfig) {
			Write-WarnMsg "Connection configuration failed. Please try again."
			Write-Host ""
		}
	}

	Write-Ok "Connection configured: $($connectionConfig.ServerName):$($connectionConfig.SmbPort)"

	# Step 2: Offer Native mapping (optional)
	$nativeMapping = Offer-NativeMapping -ConnectionConfig $connectionConfig -Defaults $defaults

	# Step 3: Offer RetroBat mapping (optional, detection-based)
	$retroBatMapping = Offer-RetroBatMapping -ConnectionConfig $connectionConfig -Defaults $defaults

	# Step 4: Offer MAME mapping (optional, detection-based)
	$mameMapping = Offer-MameMapping -ConnectionConfig $connectionConfig -Defaults $defaults

	# Save settings
	$settingsToSave = @{
		ServerName = $connectionConfig.ServerName
		SmbPort = [string]$connectionConfig.SmbPort
		MappingScope = $connectionConfig.MappingScope
	}

	if ($nativeMapping) {
		$settingsToSave['NativeDriveLetter'] = $nativeMapping.DriveLetter
		$settingsToSave['NativeShareRoot'] = $nativeMapping.DriveRoot
	}
	if ($retroBatMapping) {
		$settingsToSave['RetroBatDriveLetter'] = $retroBatMapping.DriveLetter
		$settingsToSave['ShareRoot'] = $retroBatMapping.DriveRoot
	}
	if ($mameMapping) {
		$settingsToSave['MameDriveLetter'] = $mameMapping.DriveLetter
	}

	Save-StoredSettings -Settings $settingsToSave
	Write-Ok "Saved settings to registry: HKCU\Software\TransFS\RetroBatSync"

	# Step 5: Handle RetroBat BIOS copy if RetroBat was mapped
	if ($retroBatMapping -and $nativeMapping) {
		Write-Host ""
		Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
		Write-Host "RetroBat BIOS Setup (Optional)" -ForegroundColor Cyan
		Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor White
		Write-Host ""
		Write-Info "For network BIOSes to work, we can copy files from your local RetroBat"
		Write-Info "installation to the Native filestore and update RetroBat's config."
		Write-Host ""

		$targetBiosDir = Join-Path $nativeMapping.DriveRoot "Clients\RetroBat\bios"
		$biosAlreadyExists = Test-Path $targetBiosDir -PathType Container

		if ($biosAlreadyExists) {
			Write-Info "BIOS folder already exists: $targetBiosDir"
			Write-Info ""
			$proceedWithBios = Prompt-WithDefault "Copy/update BIOS files from local RetroBat? (Y/N)" "N"
		}
		else {
			$proceedWithBios = Prompt-WithDefault "Copy BIOS files from local RetroBat to network? (Y/N)" "Y"
		}

		if ($proceedWithBios.ToUpperInvariant() -eq "Y") {
			$retroBatDir = $retroBatMapping['RetroBatDir']
			$sourceBiosDir = Join-Path $retroBatDir "bios"
			
			if (-not (Test-Path $sourceBiosDir -PathType Container)) {
				Write-WarnMsg "RetroBat BIOS folder not found: $sourceBiosDir"
			}
			else {
				Write-Info "Preparing target BIOS folder..."
				try {
					New-Item -Path $targetBiosDir -ItemType Directory -Force | Out-Null
				}
				catch {
					throw "Failed to create BIOS folder: $targetBiosDir. $($_.Exception.Message)"
				}

				if (-not (Test-PathWritable $targetBiosDir)) {
					Write-WarnMsg "Target BIOS folder is not writable: $targetBiosDir"
				}
				else {
					Write-Info "Copying BIOS files (this may take a few moments)..."
					Write-Info "  From: $sourceBiosDir"
					Write-Info "  To:   $targetBiosDir"
					Write-Host ""

					Copy-BiosWithProgress -SourceDir $sourceBiosDir -DestinationDir $targetBiosDir

					$srcCount = (Get-ChildItem -Path $sourceBiosDir -Recurse -File).Count
					$dstCount = (Get-ChildItem -Path $targetBiosDir -Recurse -File).Count

					if ($dstCount -ge $srcCount) {
						Write-Ok "Copy verified. Files: $srcCount → $dstCount"
					}
					else {
						Write-WarnMsg "Copy may be incomplete. Source: $srcCount, Destination: $dstCount"
					}

					# Trigger database sync
					Write-Host ""
					Write-Info "Triggering database sync for RetroBat..."
					try {
						$apiUrl = "http://$($connectionConfig.ServerName):8000/api/db/sync?client=RetroBat"
						$response = Invoke-RestMethod -Uri $apiUrl -Method Post -TimeoutSec 300 -ErrorAction Stop

						if ($response.success) {
							Write-Ok "Database sync completed"
							if ($response.stats) {
								Write-Host "  Files added: $($response.stats.files_added)" -ForegroundColor Gray
								Write-Host "  Files updated: $($response.stats.files_updated)" -ForegroundColor Gray
							}
						}
						else {
							Write-WarnMsg "Sync returned: $($response.message)"
						}
					}
					catch {
						Write-WarnMsg "Failed to trigger sync automatically: $($_.Exception.Message)"
						Write-Info "You can run a manual sync from the TransFS web UI."
					}

					# Update RetroBat config
					Write-Host ""
					$biosPathForConfig = Join-Path $retroBatMapping.DriveRoot "bios"
					$updateConfig = Prompt-WithDefault "Update RetroBat config to use '$biosPathForConfig'? (Y/N)" "Y"
					if ($updateConfig.ToUpperInvariant() -eq "Y") {
						Update-RetroBatConfig -RetroBatDir $retroBatDir -BiosPath $biosPathForConfig
						
						# Offer ROM path update
						Write-Host ""
						$updateRomPaths = Prompt-WithDefault "Update ROM paths in es_systems.cfg to use Native drive? (Y/N)" "Y"
						if ($updateRomPaths.ToUpperInvariant() -eq "Y") {
							Write-Info "Updating ROM paths..."
							Write-Host ""
							$pathsUpdated = Update-RomPaths -RetroBatDir $retroBatDir -NativeDriveLetter $nativeMapping.DriveLetter
							if ($pathsUpdated) {
								Write-Host ""
							}
						}
						else {
							Write-Info "Skipped ROM path update."
						}
					}
					else {
						Write-Info "Skipped config update."
					}
				}
			}
		}
		else {
			Write-Info "Skipped BIOS copy."
		}
	}
	elseif ($retroBatMapping -and -not $nativeMapping) {
		Write-Host ""
		Write-WarnMsg "RetroBat mapped but Native drive not available."
		Write-Info "BIOS copy requires Native mapping (N:) for direct filestore access."
		Write-Info "Re-run this script and accept Native mapping to enable BIOS copy."
	}

	Write-Host ""
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor Green
	Write-Host "                        Setup Complete                         " -ForegroundColor Green
	Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor Green
	Write-Host ""
	
	if ($nativeMapping) {
		Write-Ok "$($nativeMapping.DriveLetter): → Native filestore"
	}
	if ($retroBatMapping) {
		Write-Ok "$($retroBatMapping.DriveLetter): → RetroBat virtual filesystem"
	}
	if ($mameMapping) {
		Write-Ok "$($mameMapping.DriveLetter): → MAME virtual filesystem"
	}
	
	Write-Host ""
	if ($script:RestartExplorerAfterExit) {
		Write-Info "Explorer restart is queued and will run when you close this window."
	}
	Write-Info "Press any key to exit..."
	$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
	Invoke-PendingExplorerRestart
}
catch {
	Write-Host ""
	Write-ErrMsg $_.Exception.Message
	Write-Host ""
	Write-Info "Press any key to exit..."
	$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
	exit 1
}
