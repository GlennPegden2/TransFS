## TransFS Samba share – auto-generated by the TransFS installer.
## Manual edits will be overwritten on the next install or upgrade.
##
## This file is included from smb.conf under the [TransFS] section,
## following the same pattern used by RetroNAS for its own shares.

comment = TransFS Virtual Filesystem
path = /mnt/transfs
browseable = yes
read only = yes
follow symlinks = yes
wide links = yes
{% if transfs_smb_allow_guest %}
guest ok = yes
{% else %}
guest ok = no
valid users = {{ transfs_user }}
force user = {{ transfs_user }}
{% endif %}
