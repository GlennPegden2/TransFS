## TransFS Samba shares – auto-generated by the TransFS installer (transfs_managed mode).
## Manual edits will be overwritten on the next install or upgrade.
##
## This file is included from /etc/samba/smb.conf at the [global] level so that
## both shares are registered without overwriting the existing smb.conf.

[TransFS]
comment = TransFS Virtual Filesystem
path = /mnt/transfs
browseable = yes
read only = no
{% if transfs_smb_allow_guest %}
guest ok = yes
{% else %}
guest ok = no
valid users = {{ transfs_user }}
force user = {{ transfs_user }}
{% endif %}
strict locking = no
locking = no
oplocks = no
level2 oplocks = no
kernel oplocks = no
kernel share modes = no
posix locking = no
strict sync = yes
sync always = yes
aio read size = 1
aio write size = 0
delete veto files = yes
veto files = /.snapshot/

[TransFSNative]
comment = TransFS Native Storage
path = {{ transfs_filestore_path }}/Native
browseable = yes
read only = no
{% if transfs_smb_allow_guest %}
guest ok = yes
{% else %}
guest ok = no
valid users = {{ transfs_user }}
force user = {{ transfs_user }}
{% endif %}
strict locking = no
locking = no
oplocks = no
kernel share modes = no
posix locking = no
